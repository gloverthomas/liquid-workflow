{
  "name": "liquid-workflow",
  "version": "0.1.0",
  "private": true,
  "description": "Liquid governed workflow: Linear trigger \u2192 Cursor SDK planner across Core + Reporting",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "trigger": "tsx src/cli-trigger.ts",
    "implement": "tsx src/cli-implement.ts",
    "eval": "tsx src/cli-eval.ts",
    "models": "tsx src/cli-models.ts",
    "typecheck": "tsc --noEmit",
    "tunnel:ha:install": "bash scripts/install-tunnel-ha.sh",
    "tunnel:ha:uninstall": "bash scripts/uninstall-tunnel-ha.sh",
    "test": "tsx --test src/access.test.ts src/workflow-eligibility.test.ts src/github-webhook.test.ts src/eval/harness-dynamic.test.ts"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.32"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0"
  }
}
