# Bind loopback only (demo BFF style). Never expose this service publicly without auth.
HOST=127.0.0.1
PORT=4100

# Cursor Dashboard → API Keys (user or service account). Required unless DRY_RUN=true.
CURSOR_API_KEY=

# Dry-run skips Agent.create and returns a synthetic plan (useful without a key).
DRY_RUN=false

# Fallback model when Cursor Router (auto-smart) is unavailable for this API key/team.
CURSOR_MODEL=composer-2.5

# Optional per-role fixed model ids (skip Router). Prefer Router Cost/Balance/Intelligence.
# CURSOR_MODEL_PLANNER=
# CURSOR_MODEL_SECURITY=
# CURSOR_MODEL_QUALITY=
# CURSOR_MODEL_IMPLEMENTER=

# Refuse /implement unless the latest plan eval passed (deterministic rubric).
EVAL_GATE=true

# Repos the cloud agent clones (both ownership boundaries).
CORE_REPO_URL=https://github.com/gloverthomas/liquid-accounting-core
REPORTING_REPO_URL=https://github.com/gloverthomas/liquid-accounting-reporting
REPO_STARTING_REF=main

# Linear webhook signing secret (from Linear → Settings → API → Webhooks).
LINEAR_WEBHOOK_SECRET=

# Optional: Slack incoming webhook for the human review brief.
# If empty, use Slack MCP / #linear-tasks manually (demo still works).
SLACK_WEBHOOK_URL=

# Optional: Slack user id to <@mention> on briefs.
SLACK_MENTION_USER_ID=

# Optional: comment back on the issue after a plan/implement run.
LINEAR_API_KEY=

# Optional: assign curated Linear issues to this user id on product signal.
LINEAR_ASSIGNEE_ID=

# Optional: GitHub merge → Linear Done.
GITHUB_WEBHOOK_SECRET=
GITHUB_MERGE_REPOS=gloverthomas/liquid-accounting-core,gloverthomas/liquid-accounting-reporting
LINEAR_DONE_STATE_ID=

# Only trigger on these Linear state names (case-insensitive).
TRIGGER_STATES=In Progress

# Only auto-trigger for these issue identifiers (comma-separated). Empty = any LIQ-* hero.
TRIGGER_ISSUE_IDS=LIQ-16,LIQ-15,LIQ-9
